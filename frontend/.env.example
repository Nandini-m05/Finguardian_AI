# Copy to .env.local for local development.
# Where the FastAPI backend runs (no trailing slash).
#   local backend:  http://localhost:8000
#   mock API:       http://localhost:8000  (npm run mock)
#   production:     https://<your-service>.run.app  (set in Cloudflare Pages instead)
VITE_API_BASE_URL=http://localhost:8000
